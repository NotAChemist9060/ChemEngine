{
  "name": "chemengine",
  "version": "0.2.4",
  "description": "Autonomous offline chemical simulation engine: classify species, predict reactions, rank by ΔG, simulate kinetics.",
  "type": "module",
  "private": true,
  "bin": {
    "chem": "src/cli/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "wrap-ansi": "^10.0.2"
  }
}
